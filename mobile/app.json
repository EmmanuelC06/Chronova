{
  "expo": {
    "name": "Chronova",
    "slug": "chronova",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chronova",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.chronova.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E6E62"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chronova.app"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://10.11.19.129:4000",
      "router": {},
      "eas": {
        "projectId": "e0863e2f-ccb1-4db2-af1d-07e835cab14c"
      }
    },
    "notification": {
      "color": "#0E6E62",
      "androidMode": "default"
    },
    "owner": "emmanuelcv"
  }
}
