{
  "expo": {
    "name": "Chronova",
    "slug": "chronova",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "chronova",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.chronova.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptativo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "versionCode": 2
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chronova.app",
      "buildNumber": "2"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.6:4000",
      "router": {},
      "eas": {
        "projectId": "e0863e2f-ccb1-4db2-af1d-07e835cab14c"
      }
    },
    "notification": {
      "icon": "./assets/icono-de-notificacion.png",
      "color": "#185A66",
      "androidMode": "default"
    },
    "owner": "emmanuelcv",
    "icon": "./assets/icono.png",
    "splash": {
      "image": "./assets/pantalla-de-inicio.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FA"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
