# ---------------------------------------------------------------
# Configuracion de Chronova API
# Copia este archivo como .env y ajusta los valores.
# ---------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Clave para firmar los tokens de sesion. CAMBIALA en produccion.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=7d

# Donde se guardan los datos.
#   memory   -> todo en RAM. No necesitas instalar nada. Ideal para probar.
#   postgres -> base de datos real. Requiere DATABASE_URL.
PERSISTENCE=memory

# Solo se usa si PERSISTENCE=postgres
DATABASE_URL=postgresql://chronova:chronova@localhost:5432/chronova
DATABASE_SSL=false

# Minutos de tolerancia para considerar una toma "a tiempo"
VENTANA_TOLERANCIA_MINUTOS=60

# Como se entregan los avisos a pacientes y cuidadores.
#   consola -> solo se registran en el log del servidor (desarrollo)
#   push    -> notificaciones reales al telefono, via Expo
#   ambos   -> las dos cosas
NOTIFICACIONES=consola

# Opcional pero recomendado en produccion. Se crea en el panel de Expo
# (expo.dev > tu proyecto > Access tokens) e impide que un tercero envie
# notificaciones haciendose pasar por Chronova.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------
# Correo (recuperacion de contrasena)
# ---------------------------------------------------------------
#   consola -> escribe el correo en la terminal del servidor. El codigo
#              aparece ahi y se puede probar el flujo entero sin
#              contratar nada. Es el valor por defecto.
#   resend  -> envia de verdad. Requiere RESEND_API_KEY.
CORREO=consola
# RESEND_API_KEY=
# CORREO_REMITENTE=Chronova <no-responder@tudominio.com>
