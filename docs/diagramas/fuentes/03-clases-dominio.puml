@startuml 03-clases-dominio
' ============================================================
'  Chronova — Diagrama de clases de la capa de dominio
'  Refleja backend/src/domain/
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #4E5C59
skinparam roundcorner 6

skinparam class {
  BorderColor #185A66
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #E1EFF2
  FontColor #101817
  AttributeFontColor #4E5C59
  BorderThickness 1.2
}
skinparam enum {
  BorderColor #40606E
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DFE9ED
}
skinparam note {
  BorderColor #A0530A
  BackgroundColor #FBF1E6
  FontSize 11
}
skinparam package {
  BorderColor #C2CFCC
  BackgroundColor #FBFCFC
  FontColor #4E5C59
}

' Con siete entidades el diagrama en vertical se volvia una franja de
' 4400 px de ancho, ilegible impresa. En horizontal cabe en una pagina.
left to right direction

hide empty members

' =================== ENTIDADES ===================


  class Paciente {
    + {readonly} id : Identificador
    + {readonly} creadoEn : Date
    - nombre : string
    - email : Email
    - telefono : Telefono
    - fechaDeNacimiento : FechaLocal
    - contrasenaCifrada : string
    - zonaHoraria : ZonaHoraria
    - preferencias : PreferenciasDeAccesibilidad
    - activo : boolean
    - sesionesValidasDesde : Date
    --
    + {static} registrar(datos) : Paciente
    + edadEn(fecha) : number
    + esAdultoMayorEn(fecha) : boolean
    + actualizarPerfil(cambios)
    + cambiarPreferencias(prefs)
    + <b>cambiarContrasena(hash, ahora)</b>
    + <b>cerrarSesionesAbiertas(ahora)</b>
    + desactivar(ahora)
  }

  class Cuidador {
    + {readonly} id : Identificador
    + {readonly} creadoEn : Date
    - nombre : string
    - email : Email
    - telefono : Telefono
    - contrasenaCifrada : string
    - rol : string
    - activo : boolean
    - sesionesValidasDesde : Date
    --
    + {static} registrar(datos) : Cuidador
    + actualizarPerfil(cambios)
    + <b>cambiarContrasena(hash, ahora)</b>
    + <b>cerrarSesionesAbiertas(ahora)</b>
    + desactivar(ahora)
  }

  class Medicamento {
    + {readonly} id : Identificador
    + {readonly} pacienteId : Identificador
    - nombre : string
    - dosis : Dosis
    - frecuencia : Frecuencia
    - horarios : Hora[]
    - fechaInicio : FechaLocal
    - fechaFin : FechaLocal
    - instrucciones : string
    - stock : Stock
    - activo : boolean
    --
    + {static} crear(datos) : Medicamento
    + estaVigenteEn(fecha) : boolean
    + <b>horariosDelDia(fecha)</b> : Hora[]
    + registrarConsumoDeUnaDosis()
    + reabastecer(unidades)
    + definirUmbralDeAlerta(umbral)
    + actualizar(cambios)
    + suspender()
    + perteneceA(pacienteId) : boolean
  }

  class Toma {
    + {readonly} id : Identificador
    + {readonly} medicamentoId : Identificador
    + {readonly} pacienteId : Identificador
    + {readonly} programadaOriginalmentePara : Date
    - programadaPara : Date
    - estado : EstadoDeToma
    - resueltaEn : Date
    - origenDelRegistro : OrigenDeRegistro
    - registradaPorId : Identificador
    - observaciones : string
    - vecesPospuesta : number
    --
    + {static} programar(datos) : Toma
    + <b>confirmar(datos)</b>
    + <b>omitir(datos)</b>
    + <b>posponer(minutos, ahora)</b>
    + cerrarPorFaltaDeRespuesta(ahora)
    + puntualidad(tolerancia) : Puntualidad
    + minutosDeDesfase() : number
    + estaVencidaEn(ahora, gracia) : boolean
  }

  class Vinculo {
    + {readonly} id : Identificador
    + {readonly} cuidadorId : Identificador
    + {readonly} pacienteId : Identificador
    + {readonly} solicitadoPor : Origen
    - estado : EstadoDeVinculo
    - parentesco : string
    - permisos : PermisosDelCuidador
    - resueltoEn : Date
    --
    + {static} solicitar(datos) : Vinculo
    + aceptar(ahora)
    + rechazar(ahora)
    + revocar(ahora)
    + cambiarPermisos(nuevos)
    + <b>autorizar(permiso)</b> : boolean
  }

  class Dispositivo {
    + {readonly} id : Identificador
    + {readonly} token : TokenDeDispositivo
    + {readonly} registradoEn : Date
    - propietarioId : Identificador
    - tipoDePropietario : TipoDePropietario
    - plataforma : Plataforma
    - ultimoUsoEn : Date
    --
    + {static} registrar(datos) : Dispositivo
    + <b>reasignarA(propietario, tipo, ahora)</b>
    + marcarComoUsado(ahora)
    + perteneceA(propietarioId) : boolean
  }

  class SolicitudDeRecuperacion {
    + {readonly} id : Identificador
    + {readonly} usuarioId : Identificador
    + {readonly} tipoDeCuenta : TipoDeCuenta
    + {readonly} codigoCifrado : string
    + {readonly} creadaEn : Date
    + {readonly} expiraEn : Date
    - intentos : number
    - usadaEn : Date
    --
    + {static} MINUTOS_DE_VIGENCIA = 30
    + {static} MAXIMO_DE_INTENTOS = 5
    + {static} abrir(datos) : SolicitudDeRecuperacion
    + <b>motivoParaRechazar(ahora)</b> : MotivoDeRechazo
    + registrarIntento()
    + marcarComoUsada(ahora)
  }

' =================== VALUE OBJECTS ===================


  class Dosis <<VO>> {
    + {readonly} cantidad : number
    + {readonly} unidad : UnidadDeDosis
    --
    + {static} desde(cantidad, unidad) : Dosis
    + descripcion : string
    + <b>unidadesConsumidasPorToma</b> : number
  }

  class Stock <<VO>> {
    + {readonly} unidadesDisponibles : number
    + {readonly} umbralDeAlerta : number
    --
    + {static} desde(unidades, umbral) : Stock
    + {static} sinControl() : Stock
    + <b>necesitaReabastecimiento</b> : boolean
    + estaAgotado : boolean
    + descontar(unidades) : Stock
    + reabastecer(unidades) : Stock
  }

  class Frecuencia <<VO>> {
    + {readonly} tipo : TipoDeFrecuencia
    + {readonly} diasDeLaSemana : number[]
    + {readonly} intervaloEnDias : number
    --
    + {static} diaria() : Frecuencia
    + {static} diasDeLaSemana(dias) : Frecuencia
    + {static} cadaNDias(n) : Frecuencia
    + <b>aplicaEn(fecha, inicio)</b> : boolean
  }

  class PreferenciasDeAccesibilidad <<VO>> {
    + {readonly} tamanoDeLetra : TamanoDeLetra
    + {readonly} altoContraste : boolean
    + {readonly} alertasSonoras : boolean
    + {readonly} alertasVibracion : boolean
    + {readonly} minutosDeGracia : number
  }

  class Hora <<VO>> {
    + {readonly} horas : number
    + {readonly} minutos : number
    --
    + {static} desde(texto) : Hora
    + minutosDesdeMedianoche : number
  }

  class FechaLocal <<VO>> {
    + {readonly} anio : number
    + {readonly} mes : number
    + {readonly} dia : number
    --
    + {static} desde(texto) : FechaLocal
    + diaDeLaSemana : number
    + sumarDias(n) : FechaLocal
    + diasHasta(otra) : number
  }

  class ZonaHoraria <<VO>> {
    + {readonly} valor : string
    --
    + {static} desde(valor) : ZonaHoraria
    + <b>instanteDe(fecha, hora)</b> : Date
    + <b>fechaLocalDe(instante)</b> : FechaLocal
    + horaDePareDe(instante) : string
    + inicioDelDia(fecha) : Date
  }

  class Email <<VO>> {
    + {readonly} valor : string
    + {static} desde(valor) : Email
  }

  class Identificador <<VO>> {
    + {readonly} valor : string
    + {static} desde(valor) : Identificador
    + esIgualA(otro) : boolean
  }

  class TokenDeDispositivo <<VO>> {
    + {readonly} valor : string
    --
    + {static} desde(valor) : TokenDeDispositivo
    + esIgualA(otro) : boolean
  }

  class CodigoDeRecuperacion <<VO>> {
    + {readonly} valor : string
    --
    + {static} LONGITUD = 6
    + {static} desde(texto) : CodigoDeRecuperacion
    + esIgualA(otro) : boolean
  }

' =================== SERVICIO DE DOMINIO ===================

class ResumenDeAdherencia <<servicio de dominio>> {
  + {readonly} totalProgramadas : number
  + {readonly} tomadas : number
  + {readonly} omitidas : number
  + {readonly} pendientes : number
  --
  + {static} <b>calcular(tomas, tolerancia)</b>
  + porcentaje : number
  + nivel : NivelDeAdherencia
  + requiereAtencionDelCuidador : boolean
}

' =================== ENUMERACIONES ===================

enum EstadoDeToma {
  PENDIENTE
  POSPUESTA
  TOMADA
  OMITIDA
}

enum EstadoDeVinculo {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  REVOCADO
}

enum NivelDeAdherencia {
  BUENA
  REGULAR
  BAJA
  SIN_DATOS
}

enum TipoDePropietario {
  PACIENTE
  CUIDADOR
}

enum MotivoDeRechazo {
  CADUCADA
  YA_USADA
  DEMASIADOS_INTENTOS
  CODIGO_INCORRECTO
}

' =================== RELACIONES ===================

Paciente "1" *-- "1" PreferenciasDeAccesibilidad
Paciente "1" *-- "1" ZonaHoraria
Medicamento "1" *-- "1..2" FechaLocal : inicio / fin
ZonaHoraria ..> FechaLocal : traduce con >
Paciente "1" o-- "0..*" Medicamento : sigue >
Medicamento "1" *-- "1" Dosis
Medicamento "1" *-- "1" Stock
Medicamento "1" *-- "1" Frecuencia
Medicamento "1" *-- "1..12" Hora : horarios
Medicamento "1" o-- "0..*" Toma : genera >
Paciente "1" o-- "0..*" Toma : registra >

Paciente "1" -- "0..*" Vinculo
Cuidador "1" -- "0..*" Vinculo : acompana a >

Toma ..> EstadoDeToma
Vinculo ..> EstadoDeVinculo
ResumenDeAdherencia ..> NivelDeAdherencia
ResumenDeAdherencia ..> Toma : calcula sobre >

Paciente ..> Email
Cuidador ..> Email
Paciente ..> Identificador

Dispositivo "1" *-- "1" TokenDeDispositivo
Dispositivo ..> TipoDePropietario
Paciente "1" o-- "0..*" Dispositivo : recibe avisos en >
Cuidador "1" o-- "0..*" Dispositivo : recibe avisos en >

SolicitudDeRecuperacion ..> MotivoDeRechazo
SolicitudDeRecuperacion ..> CodigoDeRecuperacion : cifra >
Paciente "1" o-- "0..*" SolicitudDeRecuperacion : abre >
Cuidador "1" o-- "0..*" SolicitudDeRecuperacion : abre >

note top of ResumenDeAdherencia
  <b>adherencia = tomadas / (tomadas + omitidas)</b>
  Las tomas pendientes no cuentan: todavia
  se pueden confirmar.
  BUENA >= 80%   REGULAR >= 50%   BAJA < 50%
end note

note bottom of ZonaHoraria
  Traduce entre la <b>hora de pared</b> del paciente
  ("las 8 de la manana") y el <b>instante</b> que se
  guarda y dispara la alarma. Sin ella, un servidor
  en UTC agendaba la pastilla de las 08:00 de una
  paciente colombiana a las 03:00 de la madrugada.
end note

note bottom of Toma
  <b>programadaOriginalmentePara</b> nunca cambia.
  La puntualidad se mide contra esa hora, no
  contra la corrida por los aplazamientos: de lo
  contrario posponer tres veces haria que toda
  toma pareciera puntual.
end note

note top of Cuidador
  <b>sesionesValidasDesde</b> es lo que permite cerrar
  las sesiones abiertas sin que el servidor guarde
  ni una sola sesion. En vez de recordar los tokens
  que ha repartido, recuerda DESDE CUANDO los
  acepta: cambiar la contrasena mueve esa fecha y
  todos los tokens anteriores dejan de valer.
end note

note right of Stock
  Inmutable: descontar() y
  reabastecer() devuelven un
  Stock nuevo.
end note

note bottom of Dispositivo
  El <b>token</b> identifica un aparato, no a una
  persona. Por eso puede cambiar de dueno:
  si la hija instala la app en el telefono
  viejo de su madre, <b>reasignarA()</b> mueve la
  fila en vez de crear otra. Dos filas con el
  mismo token significan avisos duplicados.
end note

note bottom of SolicitudDeRecuperacion
  Tres reglas la protegen, y las tres viven
  <b>aqui</b>, no en el servidor web ni en la base:
  caduca a los 30 minutos, se usa <b>una sola vez</b>
  y admite <b>cinco intentos</b>.

  <b>registrarIntento()</b> se llama antes de saber si
  el codigo era correcto: un contador que solo
  cuenta fallos se esquiva alternando codigos.
end note

@enduml
